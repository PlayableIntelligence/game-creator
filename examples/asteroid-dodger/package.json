{
  "name": "asteroid-dodger",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test --test-concurrency=1 \"tests/**/*.spec.js\"",
    "test:headed": "BROWSER_TEST_HEADED=1 node --test --test-concurrency=1 \"tests/**/*.spec.js\"",
    "test:update-snapshots": "BROWSER_TEST_UPDATE_SNAPSHOTS=1 node --test --test-concurrency=1 \"tests/**/*.spec.js\"",
    "verify": "node scripts/verify-runtime.mjs",
    "validate": "node scripts/validate-architecture.mjs",
    "iterate": "node scripts/iterate-client.js --url http://localhost:3000"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "@strudel/web": "^1.3.0"
  },
  "devDependencies": {
    "vite": "^7.3.1"
  }
}
